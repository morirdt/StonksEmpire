# ---------------------------------------------------------------------------
# Stonks Empire — local environment
# Copy to .env (`make setup`) and fill in. NEVER commit .env.
# Nested settings use a double underscore: DB__HOST -> Settings.db.host
# ---------------------------------------------------------------------------

# --- app ---
ENVIRONMENT=local              # local | test | ci | prod
DEBUG=true
LOG_LEVEL=DEBUG                # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                 # unset => JSON only in prod

# --- security ---
# Required, no default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-replace-me-32chars+

# --- http ---
# JSON array or comma-free single value; the Vite dev server runs on 5173.
CORS_ORIGINS=["http://localhost:5173"]

# --- database ---
# NOTE: host port is 5433, not 5432 — see docker-compose.yml. This avoids a
# clash with any Postgres already listening on the host's 5432.
DB__HOST=localhost
DB__PORT=5433
DB__USER=stonks
DB__PASSWORD=stonks
DB__NAME=stonks_empire
DB__ECHO=false

# --- postgres container (used by docker compose, not by the app) ---
POSTGRES_HOST_PORT=5433

# --- observability (optional) ---
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- market data ---
# `fake` needs no credentials and is what a fresh clone runs on: deterministic
# pseudo-random walks seeded by ticker. Switch to a real provider only once its
# key is set below — starting with one selected and unset fails at startup.
MARKET_DATA__PROVIDER=fake

# Free-tier keys. Finnhub: https://finnhub.io/register (quotes + universe).
# Tiingo: https://www.tiingo.com/account/api/token (adjusted daily history).
# Neither provider is implemented yet — see docs/phases/phase-2-market-data.md.
# MARKET_DATA__FINNHUB_API_KEY=
# MARKET_DATA__TIINGO_API_KEY=

# How stale a cached quote may get before the next read refetches it.
MARKET_DATA__QUOTE_TTL_SECONDS=60

# --- frontend (Vite: only VITE_* vars reach the browser bundle) ---
VITE_API_BASE_URL=http://localhost:8000
