# The working tree lives on a Windows drive mounted into WSL (/mnt/c), where
# small-file operations are ~150x slower than on the Linux filesystem.
#
# node-linker=hoisted avoids pnpm's symlink layout, which multiplies drvfs
# round-trips. Do NOT add package-import-method=copy: the pnpm store also
# lives on /mnt/c, so hardlinks work and copying is dramatically slower.
node-linker=hoisted
